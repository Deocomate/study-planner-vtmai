# =====================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO COOLIFY / PRODUCTION
# =====================================================================
# Trong Coolify: Điền các biến này tại mục "Environment Variables"

# --- Cơ bản & Bảo mật ---
PORT=3000
HOST=0.0.0.0
DATA_DIR=/data

# Địa chỉ domain công khai của trang web (Coolify FQDN), ví dụ: https://study.example.com
APP_BASE_URL=https://study.example.com

# Đặt = 1 khi chạy với domain HTTPS (bật cờ Secure cho Cookie đăng nhập)
COOKIE_SECURE=1

# Mã bí mật thiết lập lần đầu (BẮT BUỘC TRÊN SERVER CÔNG KHAI)
# Khi truy cập lần đầu để tạo tài khoản Phụ huynh & mã PIN cho con, hệ thống sẽ yêu cầu mã này.
SETUP_CODE=MySecretSetupCode2026

# Dung lượng upload tối đa (MB)
MAX_UPLOAD_MB=10

# --- Cấu hình gửi Email nhắc việc (Tuỳ chọn: chọn Resend hoặc SMTP) ---
MAIL_FROM="Family Study Planner <planner@example.com>"

# Cách 1: Resend (https://resend.com)
RESEND_API_KEY=

# Cách 2: SMTP (Gmail với App Password hoặc SMTP server riêng)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
