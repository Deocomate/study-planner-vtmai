# =====================================================================
# STUDY PLANNER - FILE MÔI TRƯỜNG MÁY CHỦ (.env.example)
# =====================================================================
# Dùng để điền vào mục Environment Variables trên Coolify Dashboard

# --- 1. Mạng và Máy chủ nội bộ ---
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DATA_DIR=/data
TZ=Asia/Ho_Chi_Minh

# --- 2. Bảo vệ bằng mật khẩu (NÊN ĐIỀN) ---
# Khi đặt APP_PASSWORD, trình duyệt sẽ hỏi tên + mật khẩu trước khi mở web.
# APP_USER để trống = tên đăng nhập gì cũng được, chỉ cần đúng mật khẩu.
APP_USER=
APP_PASSWORD=

# --- 3. Giới hạn dung lượng (MB) ---
MAX_UPLOAD_MB=20
MAX_IMPORT_MB=1024

# --- 4. Sao lưu tự động (số bản giữ lại trong /data/backups) ---
KEEP_BACKUPS=30
