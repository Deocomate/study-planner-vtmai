# =====================================================================
# STUDY PLANNER - FILE MÔI TRƯỜNG MÁY CHỦ (.env.server)
# =====================================================================
# Dùng để điền vào mục Environment Variables trên Coolify Dashboard

# --- 1. Mạng và Máy chủ nội bộ ---
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DATA_DIR=/data

# --- 2. Tên miền & Bảo mật (CẦN ĐIỀN) ---
# Tên miền truy cập chính thức của web (VD: https://study.giadinh.vn hoặc https://study.example.com)
APP_BASE_URL=https://study.example.com

# Bắt buộc đặt = 1 khi chạy trên HTTPS qua Coolify (đảm bảo bảo mật Cookie session)
COOKIE_SECURE=1

# MÃ THIẾT LẬP LẦN ĐẦU (Thay bằng mật mã bí mật của riêng phụ huynh)
# Chỉ khi có mã này bạn mới có thể tạo mật khẩu Admin/Phụ huynh và mã PIN cho con lúc vừa deploy
SETUP_CODE=BenShin2026@MatKhauCaiDat

# Dung lượng tối đa cho mỗi file đính kèm (MB)
MAX_UPLOAD_MB=10

# --- 3. Cấu hình gửi Email nhắc việc (Tuỳ chọn: Nếu chưa dùng thì để trống) ---
# Cách 1: Gửi qua Gmail SMTP (cần tạo App Password trong Google Account)
MAIL_FROM="Study Planner <planner@example.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=

# Cách 2: Gửi qua dịch vụ Resend (https://resend.com)
RESEND_API_KEY=
