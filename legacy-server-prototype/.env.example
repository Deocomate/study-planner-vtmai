# Copy this file to ".env" (or set the same names in your hosting dashboard). Never share or upload the real values.

# --- Basics ---
PORT=3000
HOST=0.0.0.0
# Folder that holds the database and uploaded files. On a host, point this at a PERSISTENT disk.
DATA_DIR=./data
# Public address of the site (used for links inside emails), e.g. https://study.example.com
APP_BASE_URL=
# Set to 1 when the site is served over https (cookies become "Secure").
COOKIE_SECURE=0
# Required on a public server: a secret code needed once, at first-time setup.
SETUP_CODE=
MAX_UPLOAD_MB=10

# --- Email: choose ONE option (leave all empty = no real email) ---
MAIL_FROM="Study Planner <you@example.com>"
# Option 1: Resend (https://resend.com)
RESEND_API_KEY=
# Option 2: SMTP (Gmail: smtp.gmail.com, port 465, SMTP_SECURE=tls, use an "App password")
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
# Developer only: write emails to a file instead of sending. NOT a real send.
EMAIL_DEV_OUTBOX=

# --- Reading pictures / PDFs (optional, paid per use) ---
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-sonnet-5-5
